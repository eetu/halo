{
  "name": "halo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "validate": "yarn typecheck && yarn lint",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test -c ./playwright.configuration.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@floating-ui/react": "^0.27.20",
    "@glowbox/react": "^1.12.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@anarkisti/biome-config": "^1.0.0",
    "@biomejs/biome": "^2.5.15",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.1",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "packageManager": "yarn@4.18.0"
}
